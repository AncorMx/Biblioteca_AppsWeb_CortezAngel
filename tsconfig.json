{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",

    "lib": ["ES2022", "DOM"],
    "strict": true,                   // no negociable en esta materia
    "noUncheckedIndexedAccess": true,

    "esModuleInterop": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "types": ["node"]      // habilita process, console, etc.
  },
  "include": ["src/**/*", "contratos/**/*", "http/**/*", "publico/**/*"]
}
